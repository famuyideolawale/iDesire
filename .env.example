# Optional: omit DATABASE_URL to keep using the local .local directory.
DATABASE_URL=
# Generate a random secret of at least 48 characters for hosted sessions.
SESSION_SECRET=
# Only needed on first cloud initialization: JSON for the existing Developer
# account, including its salted password hash. Never commit the real value.
BOOTSTRAP_DEVELOPER_JSON=
# Optional public HTTPS origin; Render supplies RENDER_EXTERNAL_URL automatically.
APP_ORIGIN=
# Neon private S3-compatible image storage. Credentials need read AND write scopes.
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MEDIA_BUCKET=website-media
